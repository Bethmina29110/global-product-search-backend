# ============================================
# GLOBAL PRODUCT SEARCH BACKEND - ENVIRONMENT EXAMPLE
# ============================================
# Copy this file to .env and fill in the values.
# In production, ensure all sensitive variables are set.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development                             # development, production, test, staging
PORT=3000                                        # Port for the server to listen on
API_PREFIX=api/v1                                # API version prefix
APP_NAME="Global Product Search"                 # Application name
APP_URL=http://localhost:3000                    # Base URL for the application

# ============================================
# DATABASE
# ============================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/global_product_search"
DIRECT_URL="postgresql://postgres:password@localhost:5432/global_product_search"

# ============================================
# JWT SECURITY
# ============================================
# Use strong, random secrets in production (min 32 chars)
JWT_SECRET=your_32_character_long_access_secret_here
JWT_REFRESH_SECRET=your_32_character_long_refresh_secret_here

# ============================================
# CORS
# ============================================
# Comma-separated list for production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ============================================
# REDIS (Optional Caching & WS Scaling)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# EMAIL (SMTP)
# ============================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=secret_password
MAIL_FROM_ADDRESS=noreply@example.com
